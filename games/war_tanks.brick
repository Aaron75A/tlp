GAME_TYPE TANKS

GAME_GRID (40,25)

#Lógica
ON START:
  SPAWN ENEMY_TANK_GENERIC AT (0,0)
  SPAWN ENEMY_TANK_STRONG AT (37,0)
  SPAWN ENEMY_TANK_FAST AT (0,22)
  SPAWN PLAYER AT (37,22)
  SPAWN WALL
END


#Definicion de elementos

DEFINE SHAPE WALL:
    STATE 1:
        [1]
    COLOR #B85D19
    HEALTH 50
END

DEFINE SHAPE PLAYER_TANK:
    STATE 1:
        [0,1,0]
        [1,1,1]
        [1,1,1]
    STATE 2:
        [1,1,0]
        [1,1,1]
        [1,1,0]
    STATE 3:
        [1,1,1]
        [1,1,1]
        [0,1,0]
    STATE 4:
        [0,1,1]
        [1,1,1]
        [0,1,1]
    COLOR #025a06
    HEALTH 100
    DAMAGE 25
    SPEED 20
END

DEFINE SHAPE HAMMER:
    STATE 1:
        [1,1,1]
        [0,1,0]
        [0,1,0]
    COLOR #ffffff
END

DEFINE SHAPE ENEMY_TANK_GENERIC:
    STATE 1:
        [0,1,0]
        [1,1,1]
        [1,1,1]
    STATE 2:
        [1,1,0]
        [1,1,1]
        [1,1,0]
    STATE 3:
        [1,1,1]
        [1,1,1]
        [0,1,0]
    STATE 4:
        [0,1,1]
        [1,1,1]
        [0,1,1]
    COLOR #ff0000
    HEALTH 100
    DAMAGE 20
    SPEED 20
END

DEFINE SHAPE ENEMY_TANK_STRONG:
STATE 1:
        [0,1,0]
        [1,1,1]
        [1,1,1]
    STATE 2:
        [1,1,0]
        [1,1,1]
        [1,1,0]
    STATE 3:
        [1,1,1]
        [1,1,1]
        [0,1,0]
    STATE 4:
        [0,1,1]
        [1,1,1]
        [0,1,1]
    COLOR #ffe600
    HEALTH 200
    DAMAGE 40
    SPEED 10
END

DEFINE SHAPE ENEMY_TANK_FAST:
    STATE 1:
        [0,1,0]
        [1,1,1]
        [1,1,1]
    STATE 2:
        [1,1,0]
        [1,1,1]
        [1,1,0]
    STATE 3:
        [1,1,1]
        [1,1,1]
        [0,1,0]
    STATE 4:
        [0,1,1]
        [1,1,1]
        [0,1,1]
    COLOR #0cceff
    HEALTH 100
    DAMAGE 15
    SPEED 40
END

ON GRAB_HAMMER:
    HEAL 25
END

# Eventos de fin de juego
ON ZERO_HEALTH:
  GAME_OVER
END


# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
  MOVE PLAYER UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
  MOVE PLAYER DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
  MOVE PLAYER LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
  MOVE PLAYER RIGHT
END